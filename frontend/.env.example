# Copy to .env.development, .env.staging, or .env.production.
# Those files are gitignored. Use localhost or your own host. Do not commit real addresses.

# Backend API base path. Use a full URL when the browser calls a CORS-enabled API.
VITE_BASE_API='http://localhost:8080'

# File service
VITE_FILE_SERVICE_URL='http://localhost:8081'

# Router history: hash or html5
VITE_ROUTER_HISTORY='hash'

# Public path prefix. Use / when the site is served from the domain root.
VITE_PUBLIC_PATH='/'

# WebSocket URL for the local gateway
VITE_WEB_SOCKET_URL='ws://localhost:7002'
