# Ignore Gradle project-specific cache directory
.gradle
.dependency-check-data

# Ignore Gradle build output directory
build
/lib/
/bin/
**/bin/
out

# Runtime uploads and local notes (not source)
/upload-files/
/txt_docs/
/docs/

# Local databases
*.mv.db
snapadmin_internal.mv.db
**/tmp/
/tmp/

# Env and secrets. Commit only *.env.example templates.
.env
.env.*
!.env.example
!**/.env.example
frontend/.env.local
frontend/.env.*.local

# IDE
*.iml
.idea/
/.idea/
.vscode/*
!.vscode/extensions.json

# Node
node_modules/
dist/
frontend/dist/
remotion-video/out/
remotion-video/node_modules/

# Optional local AI tooling. Already tracked files stay tracked.
.serena/
.claude/
.playwright-mcp/

# OS / misc
.DS_Store
*.log
